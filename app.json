{
  "expo": {
    "name": "Órbita",
    "slug": "pcd-app",
    "scheme": "pcd-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para que tus tutores y profesionales puedan verla cuando la compartís."
      }
    },
    "android": {
      "package": "com.anonymous.pcdapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#5D5088",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para que tus tutores y profesionales puedan verla cuando la compartís.",
          "locationAlwaysAndWhenInUsePermission": "Usamos tu ubicación, también con la app cerrada, para que tus tutores y profesionales sepan dónde estás cuando la compartís.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4C3A8E"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5a5027c2-878c-45b1-85c2-23968c50ba95"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "nicolasovejero70",
    "updates": {
      "url": "https://u.expo.dev/5a5027c2-878c-45b1-85c2-23968c50ba95"
    }
  }
}
