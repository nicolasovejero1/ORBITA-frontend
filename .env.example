# Dirección del backend. Este archivo se debe copiar a `.env` y ajustar al caso.
#
# - Emulador de Android: no hace falta definirla (usa http://10.0.2.2:3000).
# - Celular físico con Expo Go: la IP de la PC en la red local, por ejemplo http://192.168.1.50:3000
# - Navegador web o simulador de iOS: http://localhost:3000
# - Sin definir y fuera del emulador de Android, la app apunta a http://localhost:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000
